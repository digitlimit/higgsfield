{
  "name": "@digitlimit/higgsfield",
  "version": "1.0.0-beta.1",
  "description": "A production-grade, strongly typed Node.js SDK for the Higgsfield AI API.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:types": "npm run build && tsc -p tsconfig.test-d.json",
    "check": "npm run typecheck && npm test && npm run test:types",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "higgsfield",
    "higgsfield-ai",
    "ai",
    "image-generation",
    "video-generation",
    "typescript",
    "sdk"
  ],
  "author": "Digitlimit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitlimit/higgsfield.git"
  },
  "bugs": {
    "url": "https://github.com/digitlimit/higgsfield/issues"
  },
  "homepage": "https://github.com/digitlimit/higgsfield#readme",
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
